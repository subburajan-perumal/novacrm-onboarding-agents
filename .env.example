# Copy to .env and fill in. Never commit .env.

# Claude (email extraction, transcript check, welcome message)
ANTHROPIC_API_KEY=

# Rocketlane (Settings -> API)
ROCKETLANE_API_KEY=

# Retell AI (voice agent). RETELL_AGENT_ID is printed by `novacrm setup-retell`.
RETELL_API_KEY=
RETELL_AGENT_ID=
# Only if not using Twilio: a Retell-purchased number (Retell numbers may only dial US)
RETELL_FROM_NUMBER=

# Twilio (carries the call to the AE's phone; Retell numbers only dial US)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Slack bot token (xoxb-...)
SLACK_BOT_TOKEN=

# Gmail OAuth desktop client JSON + token cache
GMAIL_CREDENTIALS_FILE=secrets/credentials.json
GMAIL_TOKEN_FILE=secrets/token.json

# AE phone (E.164), used by config/ae_directory.yaml via ${AE_PHONE}
AE_PHONE=+91XXXXXXXXXX
